---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubPageBanner from "../components/SubPageBanner.astro";

const title = "Medical Disclaimer | Pahal Hospital";
const description = "Read the medical disclaimer for the Pahal Hospital website, including medical advice limits, emergency guidance and doctor-patient relationship information.";
---

<BaseLayout title={title} description={description} canonicalPath="/medical-disclaimer">
  <SubPageBanner title="Medical Disclaimer" />
  <div id="sub-page-content">
    <div class="container big-font policy-content">
      <h2 class="light bordered">medical <span>disclaimer</span></h2>

      <p>
        The information provided on the <strong>Pahal Hospital</strong> website is intended solely for general
        informational and educational purposes. While we strive to keep website information accurate and up to date, it
        should not be considered a substitute for professional medical advice, diagnosis, or treatment.
      </p>

      <h3>No Medical Advice</h3>
      <p>
        The content available on this website, including text, images, articles, graphics, and other materials, is
        provided for general information only. It is not intended to diagnose, treat, cure, or prevent any disease or
        medical condition.
      </p>
      <p>
        Always consult a qualified doctor or healthcare professional regarding any medical concerns or before making
        decisions related to your health.
      </p>

      <h3>Medical Emergencies</h3>
      <p>This website is <strong>not</strong> intended for use during medical emergencies.</p>
      <p>If you are experiencing a medical emergency, please:</p>
      <ul>
        <li>Call your local emergency medical services immediately.</li>
        <li>Visit the nearest emergency department or hospital without delay.</li>
        <li>Contact Pahal Hospital directly by phone if you need urgent hospital assistance.</li>
      </ul>
      <p>Do not rely on information from this website in place of immediate medical assistance.</p>

      <h3>No Doctor-Patient Relationship</h3>
      <p>
        Your use of this website, including submitting enquiries through the contact form or communicating with Pahal
        Hospital by email or phone, does not create a doctor-patient relationship.
      </p>
      <p>
        A doctor-patient relationship is established only after an in-person or authorized clinical consultation and
        acceptance of your case by a qualified healthcare professional.
      </p>

      <h3>Accuracy of Information</h3>
      <p>
        Pahal Hospital makes reasonable efforts to keep the information on this website current and accurate. However,
        medical knowledge, treatment guidelines, hospital services, doctor availability, and facility details may change
        over time.
      </p>
      <p>Users should always verify medical information with qualified healthcare professionals.</p>

      <h3>External Links</h3>
      <p>
        This website may contain links to third-party websites for your convenience. Pahal Hospital does not endorse or
        assume responsibility for the accuracy, reliability, or content of external websites.
      </p>

      <h3>Limitation of Liability</h3>
      <p>
        Pahal Hospital, its doctors, employees, and affiliates shall not be liable for any direct, indirect, incidental,
        or consequential loss or damage resulting from the use of, or reliance upon, the information provided on this
        website.
      </p>

      <h3>Acceptance of Disclaimer</h3>
      <p>
        By accessing and using the Pahal Hospital website, you acknowledge that you have read, understood, and agreed to
        this Medical Disclaimer. If you do not agree with any part of this disclaimer, please discontinue use of this
        website.
      </p>

      <h3>Contact Us</h3>
      <p>If you have any questions regarding this Medical Disclaimer, please contact us:</p>

      <address class="policy-contact">
        <strong>Pahal Hospital</strong><br />
        Morabhagal Circle, Rander Bambakhana Road,<br />
        Morabhagal, Surat - 395005<br />
        Phone: <a href="tel:+919879771477">(+91) 9879771477</a><br />
        Email: <a href="mailto:info@pahalhospital.com">info@pahalhospital.com</a>
      </address>
    </div>
  </div>
</BaseLayout>
