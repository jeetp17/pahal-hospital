---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubPageBanner from "../components/SubPageBanner.astro";

const title = "Privacy Policy | Pahal Hospital";
const description = "Read how Pahal Hospital handles website privacy, contact form information, cookies, data security and user rights.";
---

<BaseLayout title={title} description={description} canonicalPath="/privacy-policy">
  <SubPageBanner title="Privacy Policy" />
  <div id="sub-page-content">
    <div class="container big-font policy-content">
      <h2 class="light bordered">privacy <span>policy</span></h2>

      <p>
        Welcome to <strong>Pahal Hospital</strong>. We respect your privacy and are committed to protecting any
        information you may share while using our website.
      </p>
      <p>This Privacy Policy explains how information is collected and used when you visit our website.</p>

      <h3>Information We Collect</h3>
      <p>
        Our website is intended to provide information about Pahal Hospital, our medical services, doctors,
        services, facilities, and contact details.
      </p>
      <p>We may collect limited information such as:</p>
      <ul>
        <li>Your name, phone number, and email address if you contact us through a contact form.</li>
        <li>
          Technical information such as your IP address, browser type, device information, and pages visited for
          website analytics and security purposes.
        </li>
      </ul>
      <p>
        We do <strong>not</strong> collect medical records, payment information, or any sensitive personal information
        through this website.
      </p>

      <h3>How We Use Your Information</h3>
      <p>Any information you voluntarily provide may be used to:</p>
      <ul>
        <li>Respond to your enquiries.</li>
        <li>Provide information about our hospital and services.</li>
        <li>Improve the performance and user experience of our website.</li>
        <li>Maintain website security.</li>
      </ul>

      <h3>Cookies</h3>
      <p>
        Our website may use cookies to improve functionality and analyze website traffic. You can manage or disable
        cookies through your browser settings.
      </p>

      <h3>Information Sharing</h3>
      <p>Pahal Hospital does not sell, rent, or trade your personal information.</p>
      <p>We may disclose information only when required by applicable law or to protect our legal rights.</p>

      <h3>Third-Party Links</h3>
      <p>
        Our website may contain links to third-party websites. We are not responsible for the privacy practices or
        content of those websites. Please review their privacy policies before sharing any personal information.
      </p>

      <h3>Data Security</h3>
      <p>
        We take reasonable measures to protect the information collected through our website. However, no method of data
        transmission over the internet is completely secure.
      </p>

      <h3>Your Rights</h3>
      <p>
        If you have submitted your personal information through our contact form, you may request access, correction, or
        deletion of your information by contacting us.
      </p>

      <h3>Changes to This Privacy Policy</h3>
      <p>
        We may update this Privacy Policy from time to time. Any changes will be posted on this page with the revised
        effective date.
      </p>

      <h3>Contact Us</h3>
      <p>If you have any questions regarding this Privacy Policy, please contact us:</p>

      <address class="policy-contact">
        <strong>Pahal Hospital</strong><br />
        Morabhagal Circle, Rander Bambakhana Road,<br />
        Morabhagal, Surat - 395005<br />
        Phone: <a href="tel:+919879771477">(+91) 9879771477</a><br />
        Email: <a href="mailto:info@pahalhospital.com">info@pahalhospital.com</a>
      </address>

      <p>By using this website, you agree to the terms of this Privacy Policy.</p>
    </div>
  </div>
</BaseLayout>
