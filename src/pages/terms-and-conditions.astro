---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubPageBanner from "../components/SubPageBanner.astro";

const title = "Terms & Conditions | Pahal Hospital";
const description = "Read the terms and conditions for using the Pahal Hospital website, including website information, enquiries, emergencies and third-party links.";
---

<BaseLayout title={title} description={description} canonicalPath="/terms-and-conditions">
  <SubPageBanner title="Terms & Conditions" />
  <div id="sub-page-content">
    <div class="container big-font policy-content">
      <h2 class="light bordered">terms and <span>conditions</span></h2>

      <p>
        Welcome to <strong>Pahal Hospital</strong>. By accessing or using this website, you agree to follow these Terms
        and Conditions. Please read them carefully before using the website.
      </p>

      <h3>Use of This Website</h3>
      <p>
        This website is provided to share general information about Pahal Hospital, our services, facilities,
        services, contact details, and related updates. You agree to use this website only for lawful and appropriate
        purposes.
      </p>

      <h3>Website Information</h3>
      <p>
        We make reasonable efforts to keep the information on this website accurate and up to date. However, hospital
        services, timings, doctors, facilities, and other details may change from time to time without
        prior notice.
      </p>
      <p>
        Please contact Pahal Hospital directly to confirm current information before making decisions based on website
        content.
      </p>

      <h3>No Medical Advice</h3>
      <p>
        The content on this website is for general information only. It should not be treated as medical advice,
        diagnosis, or treatment guidance. Always consult a qualified medical professional for advice regarding your
        health condition.
      </p>

      <h3>Contact Forms and Enquiries</h3>
      <p>
        If you submit an enquiry through this website, you agree to provide accurate contact information. Submitting an
        enquiry does not create a doctor-patient relationship and does not confirm an appointment unless confirmed by
        Pahal Hospital.
      </p>

      <h3>Emergency Situations</h3>
      <p>
        This website should not be used for medical emergencies. In an emergency, please contact the hospital directly
        by phone or visit the nearest emergency medical facility.
      </p>

      <h3>Intellectual Property</h3>
      <p>
        All website content, including text, images, branding, layout, and design elements, belongs to Pahal Hospital
        or is used with permission. You may not copy, reproduce, distribute, or modify website content without prior
        written permission.
      </p>

      <h3>Third-Party Links</h3>
      <p>
        This website may include links to third-party websites or services. Pahal Hospital is not responsible for the
        content, availability, accuracy, or privacy practices of third-party websites.
      </p>

      <h3>Limitation of Liability</h3>
      <p>
        Pahal Hospital will not be responsible for any loss or damage arising from the use of this website, reliance on
        website information, temporary website unavailability, or linked third-party content.
      </p>

      <h3>Changes to These Terms</h3>
      <p>
        We may update these Terms and Conditions from time to time. Any changes will be posted on this page with the
        revised effective date.
      </p>

      <h3>Contact Us</h3>
      <p>If you have any questions regarding these Terms and Conditions, please contact us:</p>

      <address class="policy-contact">
        <strong>Pahal Hospital</strong><br />
        Morabhagal Circle, Rander Bambakhana Road,<br />
        Morabhagal, Surat - 395005<br />
        Phone: <a href="tel:+919879771477">(+91) 9879771477</a><br />
        Email: <a href="mailto:info@pahalhospital.com">info@pahalhospital.com</a>
      </address>

      <p>By using this website, you agree to these Terms and Conditions.</p>
    </div>
  </div>
</BaseLayout>
